# Optional: an OpenAI-compatible LLM that rewrites the retrieved FAQ answer.
# Leave LLM_API_KEY empty and the chatbot still works (it returns the best FAQ match).
# Groq (free key at https://console.groq.com):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
# Local Ollama instead:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2
